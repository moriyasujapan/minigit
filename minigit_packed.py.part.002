""".split())))
here=os.path.dirname(os.path.abspath(__file__))
tf=tarfile.open(fileobj=io.BytesIO(DATA)); src=None
for m in tf:
    raw=tf.extractfile(m).read(); p=os.path.join(here,m.name)
    if m.name=='minigit.py': src=raw
    if not os.path.exists(p): open(p,'wb').write(raw); print('extracted',m.name)
    elif open(p,'rb').read()!=raw: print('existing file kept (bundled code runs)',m.name)
exec(compile(src.decode("utf-8"),"minigit.py","exec"),{"__name__":"__main__","__file__":os.path.join(here,"minigit.py")})
